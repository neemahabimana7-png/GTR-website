# Copy to .env in the repository root. Never use local defaults for production.
# Select settings using --settings or the shell, not this .env file.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Development defaults to console output, with local-review@localhost as a test sink.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
CONTACT_MIN_SECONDS=2
CONTACT_RATE_LIMIT=5
ADMIN_LOGIN_RATE_LIMIT=10
# Production: replace all placeholders and remove EMAIL_BACKEND above.
# SECRET_KEY=
# ALLOWED_HOSTS=your-approved-domain
# CSRF_TRUSTED_ORIGINS=https://your-approved-domain
# DB_ENGINE=sqlite
# SQLITE_PATH=/data/db.sqlite3
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=5432
# DB_SSLMODE=verify-full
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# DEFAULT_FROM_EMAIL=
# CONTACT_RECIPIENTS=
# TRUST_HTTPS_PROXY=false
